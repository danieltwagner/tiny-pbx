<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- Extension 104 as a UAS (registered by register_compact.xml from the same
     port). Checks what the proxy did to the INVITE, answers, waits for BYE.
     Run with -rtp_echo so the caller hears itself. -->
<scenario name="uas 104">
  <recv request="INVITE" crlf="true">
    <action>
      <!-- R-URI rewritten to the registered contact -->
      <ereg regexp="^INVITE sip:104@[0-9.]+:[0-9]+ SIP/2.0" search_in="msg" check_it="true" assign_to="dummy"/>
      <ereg regexp="Record-Route: &lt;sip:[0-9.]+:[0-9]+;lr;pbx-dialog=[0-9a-f.]+>" search_in="msg" check_it="true" assign_to="dummy"/>
      <ereg regexp="69" search_in="hdr" header="Max-Forwards:" check_it="true" assign_to="dummy"/>
      <ereg regexp="branch=z9hG4bK-pbx-" search_in="hdr" header="Via:" check_it="true" assign_to="dummy"/>
      <!-- the caller's credentials must not leak to the callee -->
      <ereg regexp="Proxy-Authorization" search_in="msg" check_it_inverse="true" assign_to="dummy"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:104@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="50"/>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:104@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000

    ]]>
  </send>

  <recv request="ACK" crlf="true"/>

  <recv request="BYE" timeout="30000"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="100"/>
</scenario>
